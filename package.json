{
  "name": "auction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts tests server/src vite.config.ts",
    "preview": "vite preview",
    "dev:all": "node scripts/dev.mjs",
    "lint:backend": "oxlint server/src",
    "build:all": "npm run build && npm --prefix server run build",
    "test": "node scripts/run-tests.mjs",
    "test:frontend": "node scripts/run-tests.mjs frontend",
    "test:health": "node scripts/run-tests.mjs health",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "check": "npm --prefix server run db:generate && npm run lint && npm run build:all && npm test",
    "smoke": "node scripts/smoke-check.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
